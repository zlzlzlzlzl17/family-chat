# Copy to .env at the repository root. No real credentials are included.
# Run from familychat_web: node --env-file=../.env server.js
# Paths below are relative to that working directory.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0
JWT_SECRET=development-only-change-me
DB_PATH=./data/chat.sqlite
UPLOAD_DIR=./uploads
APP_RELEASE_DIR=./app_release
BLOG_UPLOAD_DIR=./blog_uploads
# Local browser management: http://localhost:3000
# Deployment: MANAGE_HOST=manage.example.com and TRUST_PROXY_HOPS=1.
MANAGE_HOST=localhost
SEED_DEMO_USERS=false
# Local-only bootstrap account. Replace the password before starting.
# Remove both bootstrap settings after the first admin has been created.
MANAGE_BOOTSTRAP_USERNAME=local-admin
MANAGE_BOOTSTRAP_PASSWORD=local-demo-password-change-me

# Optional Android push: configure your own Firebase project and service account.
# Blank values disable FCM sending. Never put a service-account key in Android.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# A quoted value may contain escaped newline sequences (backslash+n).
FCM_PRIVATE_KEY=

# Optional legacy browser push; not required for Android messaging.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional WebRTC relay configuration.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=

# Optional Blog. Enabling it requires an independent random 32-byte key
# (base64 or 64 hex characters). Not part of the core messaging showcase.
BLOG_ENABLED=false
BLOG_AT_REST_KEY=
